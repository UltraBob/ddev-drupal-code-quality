## MutagenSync: true
set -u

PHPCBF_BIN="vendor/bin/phpcbf"

if [ ! -x "$PHPCBF_BIN" ]; then
  echo "phpcbf not found at $PHPCBF_BIN. Run 'ddev composer install' to install vendor/bin/phpcbf." >&2
  exit 127
fi

has_config=false
for config_file in .phpcs.xml phpcs.xml phpcs.xml.dist .phpcs.xml.dist; do
  if [ -f "$config_file" ]; then
    has_config=true
    break
  fi
done

if [ "$has_config" = true ]; then
  "$PHPCBF_BIN" "$@"
  exit $?
fi

echo "PHPCS config file is missing. Create .phpcs.xml in the project root (for example by reinstalling the add-on)." >&2
exit 2
