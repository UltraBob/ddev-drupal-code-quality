#!/bin/bash
#ddev-generated
set -u

source /mnt/ddev_config/commands/helpers/path-map.sh

print_help() {
  cat <<'USAGE'
Usage: ddev eslint-fix [args]

Previews ESLint fixes and applies them only after confirmation.

By default, fixes are not auto-applied when the working tree has changes
outside the target paths. This prevents mixing unrelated work with automated
fixes and makes it easier to review or revert. If you intentionally want to
apply fixes with unrelated changes present, pass --allow-dirty-outside-targets
(or --allow-dirty) to bypass this protection.
USAGE
}

has_help=false
has_version=false
has_positional=false
has_config=false
seen_double_dash=false
explicit_paths=false
auto_yes=false
allow_dirty_outside_targets=false
clean_args=()
ESLINT_TOOLCHAIN="${ESLINT_TOOLCHAIN:-auto}"
ESLINT_CONFIG_MODE="${ESLINT_CONFIG_MODE:-nearest}"

for arg in "$@"; do
  if [ "$arg" = "--yes" ]; then
    auto_yes=true
    continue
  fi
  if [ "$arg" = "--allow-dirty-outside-targets" ] || [ "$arg" = "--allow-dirty" ]; then
    # Allow applying fixes even if unrelated files are dirty.
    allow_dirty_outside_targets=true
    continue
  fi
  clean_args+=("$arg")
done

for arg in "${clean_args[@]}"; do
  if [ "$seen_double_dash" = true ]; then
    has_positional=true
    explicit_paths=true
    break
  fi
  case "$arg" in
    --)
      seen_double_dash=true
      ;;
    -h|--help)
      has_help=true
      ;;
    -V|--version)
      has_version=true
      ;;
    -c|--config|--config=*)
      has_config=true
      ;;
    --)
      ;;
    -* )
      ;;
    *)
      has_positional=true
      explicit_paths=true
      ;;
  esac
  if [ "$has_help" = true ] || [ "$has_version" = true ]; then
    break
  fi
done

if [ "$has_help" = true ]; then
  print_help
fi

PROJECT_ROOT="/var/www/html"
DOCROOT="${DCQ_DOCROOT:-web}"
DOCROOT_PATH="${PROJECT_ROOT}/${DOCROOT}"
CORE_ESLINT="${DOCROOT_PATH}/core/node_modules/eslint/bin/eslint.js"
ROOT_ESLINT="${PROJECT_ROOT}/node_modules/eslint/bin/eslint.js"
TOOLCHAIN_BIN=""
NODE_PATH=""
RESOLVE_PLUGINS_DIR=""

prefer_root=false
if [ "$ESLINT_TOOLCHAIN" = "root" ]; then
  prefer_root=true
elif [ "$ESLINT_TOOLCHAIN" = "auto" ]; then
  if [ -f "${PROJECT_ROOT}/.eslintrc.json" ] || [ -f "${PROJECT_ROOT}/.eslintrc.passing.json" ] || [ -f "${PROJECT_ROOT}/.eslintrc.jquery.json" ]; then
    prefer_root=true
  fi
fi

if [ "$prefer_root" = true ] && [ -f "$ROOT_ESLINT" ]; then
  TOOLCHAIN_BIN="$ROOT_ESLINT"
  NODE_PATH="${PROJECT_ROOT}/node_modules"
  RESOLVE_PLUGINS_DIR="$NODE_PATH"
elif [ -f "$CORE_ESLINT" ]; then
  TOOLCHAIN_BIN="$CORE_ESLINT"
  NODE_PATH="${DOCROOT_PATH}/core/node_modules"
  RESOLVE_PLUGINS_DIR="$NODE_PATH"
elif [ -f "$ROOT_ESLINT" ]; then
  TOOLCHAIN_BIN="$ROOT_ESLINT"
  NODE_PATH="${PROJECT_ROOT}/node_modules"
  RESOLVE_PLUGINS_DIR="$NODE_PATH"
else
  echo "ESLint is not installed in ${DOCROOT}/core/node_modules or node_modules." >&2
  echo "Enable corepack and run 'yarn install' in ${DOCROOT}/core, or install eslint in the project root." >&2
  exit 127
fi

if [ "$has_help" = true ]; then
  node "$TOOLCHAIN_BIN" --help
  exit $?
fi

if [ "$has_version" = true ]; then
  node "$TOOLCHAIN_BIN" --version
  exit $?
fi

REPORT_DIR="dcq-reports"
mkdir -p "$REPORT_DIR"
PATCH_FILE="${REPORT_DIR}/_eslint.patch"

normalize_path() {
  local path="$1"
  # Normalize paths into repo-relative paths for matching target prefixes.
  path="$(map_path "$path")"
  if [[ "$path" == /var/www/html/* ]]; then
    path="${path#/var/www/html/}"
  fi
  if [ "$DOCROOT" != "web" ] && [[ "$path" == web/* ]]; then
    path="${DOCROOT}/${path#web/}"
  fi
  if [[ "$path" == core/* ]]; then
    path="${DOCROOT}/$path"
  fi
  if [[ "$path" == "${DOCROOT}/"* ]]; then
    echo "$path"
    return
  fi
  if [[ "$path" == modules/* || "$path" == themes/* || "$path" == profiles/* ]]; then
    echo "${DOCROOT}/$path"
    return
  fi
  echo "$path"
}

TARGET_PREFIXES=()
RAW_PATHS=()
seen_double_dash=false
args=("${clean_args[@]}")
arg_count=${#args[@]}
index=0
while [ "$index" -lt "$arg_count" ]; do
  arg="${args[$index]}"
  if [ "$seen_double_dash" = true ]; then
    RAW_PATHS+=("$arg")
    index=$((index + 1))
    continue
  fi
  case "$arg" in
    --)
      seen_double_dash=true
      ;;
    -c|--config)
      index=$((index + 1))
      ;;
    --config=*)
      ;;
    -*)
      ;;
    *)
      RAW_PATHS+=("$arg")
      ;;
  esac
  index=$((index + 1))
done

if [ "${#RAW_PATHS[@]}" -gt 0 ]; then
  for raw in "${RAW_PATHS[@]}"; do
    TARGET_PREFIXES+=("$(normalize_path "$raw")")
  done
else
  # Default to custom code when no explicit paths are passed.
  for candidate in "${DOCROOT}/modules/custom" "${DOCROOT}/themes/custom" "${DOCROOT}/profiles/custom"; do
    if [ -d "$candidate" ]; then
      TARGET_PREFIXES+=("$candidate")
    fi
  done
fi

unrelated_changes=false
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  mapfile -t unstaged_files < <(git diff --name-only)
  mapfile -t untracked_files < <(git ls-files --others --exclude-standard)
  for file in "${unstaged_files[@]}" "${untracked_files[@]}"; do
    [ -z "$file" ] && continue
    matched=false
    for prefix in "${TARGET_PREFIXES[@]}"; do
      [ -z "$prefix" ] && continue
      if [[ "$file" == "$prefix"* ]]; then
        matched=true
        break
      fi
    done
    if [ "$matched" = false ]; then
      # Guard against applying fixes when unrelated changes are present.
      unrelated_changes=true
      break
    fi
  done
fi

CMD_BASE=(env "NODE_PATH=$NODE_PATH" node "$TOOLCHAIN_BIN" --quiet)
if [ -n "$RESOLVE_PLUGINS_DIR" ]; then
  CMD_BASE+=(--resolve-plugins-relative-to "$RESOLVE_PLUGINS_DIR")
fi
if [ "$has_config" = false ] && [ "$ESLINT_CONFIG_MODE" != "nearest" ]; then
  if [ -f "${PROJECT_ROOT}/.eslintrc.passing.json" ]; then
    CMD_BASE+=(--config="${PROJECT_ROOT}/.eslintrc.passing.json")
  else
    CMD_BASE+=(--config="${DOCROOT_PATH}/core/.eslintrc.passing.json")
    echo "Warning: using core ESLint config (${DOCROOT}/core/.eslintrc.passing.json); project config not found." >&2
  fi
fi
CMD_BASE+=(--ext .js,.yml --ignore-pattern "**/node_modules/**")

find_nearest_config() {
  local file_path="$1"
  local dir
  dir="$(dirname "$file_path")"
  while true; do
    for candidate in .eslintrc .eslintrc.json .eslintrc.yaml .eslintrc.yml .eslintrc.js .eslintrc.cjs; do
      if [ -f "$dir/$candidate" ]; then
        echo "$dir/$candidate"
        return 0
      fi
    done
    if [ "$dir" = "." ] || [ "$dir" = "/" ]; then
      break
    fi
    dir="$(dirname "$dir")"
  done
  return 1
}

resolve_plugins_dir() {
  local config_dir="$1"
  if [ -z "$config_dir" ]; then
    echo ""
    return
  fi
  if [[ "$config_dir" != /* ]]; then
    config_dir="${PROJECT_ROOT}/${config_dir}"
  fi
  if [ -d "$config_dir/node_modules" ]; then
    echo "$config_dir"
    return
  fi
  if [ -d "${PROJECT_ROOT}/node_modules" ]; then
    echo "${PROJECT_ROOT}"
    return
  fi
  if [ -d "${DOCROOT_PATH}/core/node_modules" ]; then
    echo "${DOCROOT_PATH}/core"
    return
  fi
  echo ""
}

FINAL_ARGS=()
normalize_config_path() {
  local path="$1"
  path="$(map_path "$path")"
  if [[ "$path" == /var/www/html/* ]]; then
    path="${path#/var/www/html/}"
  fi
  if [ "$DOCROOT" != "web" ] && [[ "$path" == web/* ]]; then
    path="${DOCROOT}/${path#web/}"
  fi
  if [[ "$path" == core/* ]]; then
    echo "${DOCROOT}/$path"
    return
  fi
  echo "$path"
}

normalize_docroot_arg() {
  local arg="$1"
  arg="$(map_path "$arg")"
  if [[ "$arg" == /var/www/html/* ]]; then
    arg="${arg#/var/www/html/}"
  fi
  if [ "$DOCROOT" != "web" ] && [[ "$arg" == web/* ]]; then
    arg="${DOCROOT}/${arg#web/}"
  fi
  if [[ "$arg" == "${DOCROOT}/"* ]]; then
    arg="${arg#${DOCROOT}/}"
  elif [ "$arg" = "$DOCROOT" ]; then
    arg="."
  fi
  printf '%s' "$arg"
}
if [ "$explicit_paths" = true ]; then
  args=("${clean_args[@]}")
  arg_count=${#args[@]}
  index=0
  seen_double_dash=false
  while [ "$index" -lt "$arg_count" ]; do
    arg="${args[$index]}"
    if [ "$seen_double_dash" = true ]; then
      arg="$(normalize_docroot_arg "$arg")"
      FINAL_ARGS+=("$arg")
      index=$((index + 1))
      continue
    fi
    case "$arg" in
      --)
        seen_double_dash=true
        FINAL_ARGS+=("$arg")
        ;;
      -c|--config)
        next_arg="${args[$((index + 1))]:-}"
        FINAL_ARGS+=("$arg" "$(normalize_config_path "$next_arg")")
        index=$((index + 1))
        ;;
      --config=*)
        config_value="${arg#*=}"
        FINAL_ARGS+=("--config=$(normalize_config_path "$config_value")")
        ;;
      -*)
        FINAL_ARGS+=("$arg")
        ;;
      *)
        FINAL_ARGS+=("$(normalize_path "$arg")")
        ;;
    esac
    index=$((index + 1))
  done
fi

DEFAULT_FILES=()
if [ "$explicit_paths" = false ]; then
  for candidate in "${DOCROOT}/modules/custom" "${DOCROOT}/themes/custom" "${DOCROOT}/profiles/custom"; do
    if [ -d "$candidate" ]; then
      while IFS= read -r file_path; do
        DEFAULT_FILES+=("$file_path")
      done < <(find "$candidate" -path '*/node_modules/*' -prune -o -type f \( -name '*.js' -o -name '*.yml' \) -print)
    fi
  done
  if [ "${#DEFAULT_FILES[@]}" -eq 0 ]; then
    echo "No custom JS/YML files found under modules/custom, themes/custom, or profiles/custom. Nothing to fix." >&2
    exit 2
  fi
fi

FILES=()
if [ "$explicit_paths" = false ]; then
  FILES=("${DEFAULT_FILES[@]}")
else
  FILES=("${FINAL_ARGS[@]}")
fi

DEFAULT_CONFIG=""
if [ -f "${PROJECT_ROOT}/.eslintrc.passing.json" ]; then
  DEFAULT_CONFIG="${PROJECT_ROOT}/.eslintrc.passing.json"
elif [ -f "${DOCROOT_PATH}/core/.eslintrc.passing.json" ]; then
  DEFAULT_CONFIG="${DOCROOT_PATH}/core/.eslintrc.passing.json"
fi

tmp_root="$(mktemp -d)"
trap 'rm -rf "$tmp_root"' EXIT

cd "$PROJECT_ROOT"
# Create a temp copy to preview fixes and generate a patch without touching the worktree.
tar -cf - \
  --exclude=./.git \
  --exclude=./.trunk \
  --exclude=./node_modules \
  --exclude=./vendor \
  --exclude=./dcq-reports \
  --exclude=./${DOCROOT}/core/node_modules \
  --exclude='*/.git' \
  --exclude='*/.git/*' \
  . | (cd "$tmp_root" && tar -xf -)

if [ "$ESLINT_CONFIG_MODE" = "nearest" ]; then
  # Group files by nearest config to avoid plugin conflicts across modules/themes.
  declare -A ESLINT_GROUPS
  for file_path in "${FILES[@]}"; do
    config_path="$(find_nearest_config "$file_path")"
    if [ -z "$config_path" ]; then
      # Fall back to the default passing config when nothing is found.
      config_path="$DEFAULT_CONFIG"
    fi
    ESLINT_GROUPS["$config_path"]+="$file_path"$'\n'
  done
  preview_exit=0
  for config_path in "${!ESLINT_GROUPS[@]}"; do
    if [ -z "$config_path" ]; then
      echo "No ESLint config found for nearest-mode run." >&2
      exit 2
    fi
    mapfile -t group_files <<< "${ESLINT_GROUPS[$config_path]}"
    filtered_files=()
    for item in "${group_files[@]}"; do
      [ -n "$item" ] || continue
      filtered_files+=("$item")
    done
    if [ "${#filtered_files[@]}" -eq 0 ]; then
      continue
    fi
    config_path_abs="$config_path"
    if [[ "$config_path_abs" != /* ]]; then
      config_path_abs="${PROJECT_ROOT}/${config_path_abs}"
    fi
    config_path_run="$config_path"
    if [[ "$config_path_run" == /* ]]; then
      config_path_run="$config_path_abs"
    fi
    config_dir="$(dirname "$config_path_abs")"
    plugins_dir="$(resolve_plugins_dir "$config_dir")"
    echo "ESLint-fix preview: config ${config_path_abs} (${#filtered_files[@]} file(s))." >&2
    group_cmd=(env "NODE_PATH=$NODE_PATH" node "$TOOLCHAIN_BIN" --quiet --config="$config_path_run")
    if [ -n "$plugins_dir" ]; then
      group_cmd+=(--resolve-plugins-relative-to "$plugins_dir")
    fi
    group_cmd+=(--ext .js,.yml --ignore-pattern "**/node_modules/**" --fix)
    (cd "$tmp_root" && "${group_cmd[@]}" "${filtered_files[@]}")
    status=$?
    if [ $status -ne 0 ]; then
      preview_exit=$status
    fi
  done
else
  (cd "$tmp_root" && "${CMD_BASE[@]}" --fix "${FILES[@]}")
  preview_exit=$?
fi

if [ "${preview_exit:-0}" -eq 2 ]; then
  echo "ESLint preview failed (configuration error)." >&2
  exit "$preview_exit"
fi

: > "${PATCH_FILE}.raw"
for prefix in "${TARGET_PREFIXES[@]}"; do
  [ -z "$prefix" ] && continue
  if [ ! -e "$PROJECT_ROOT/$prefix" ] && [ ! -e "$tmp_root/$prefix" ]; then
    continue
  fi
  diff -ruN \
    --exclude=.git \
    --exclude='.git/*' \
    "$PROJECT_ROOT/$prefix" "$tmp_root/$prefix" >> "${PATCH_FILE}.raw" || true
done

sed -E "s/diff -ruN( '--exclude=[^']+')+/diff -ruN/" "${PATCH_FILE}.raw" > "$PATCH_FILE"
rm -f "${PATCH_FILE}.raw"

change_count=$(grep -c '^diff -ruN ' "$PATCH_FILE" || true)
if [ "$change_count" -eq 0 ]; then
  change_count=$(grep -c '^--- ' "$PATCH_FILE" || true)
fi
fix_summary="fixes not applied"
if [ "$change_count" -eq 0 ]; then
  if [ "$auto_yes" = true ]; then
    echo "Preview patch empty; running fixes directly because --yes was set." >&2
    skip_preview_patch=true
  else
    echo "No ESLint fixes to apply. Preview reported issues, but no auto-fixable changes were found; final lint not run." >&2
    echo "ESLint-fix summary: no fixes to apply; preview only." >&2
    exit 0
  fi
fi

if [ "$unrelated_changes" = true ]; then
  if [ "$allow_dirty_outside_targets" = false ]; then
    echo "Unstaged changes detected outside target paths. Patch-only mode: not applying automatically." >&2
    echo "Re-run with --allow-dirty-outside-targets (or --allow-dirty) to apply fixes anyway." >&2
    echo "To apply the patch manually, run: git apply ${PATCH_FILE}" >&2
    echo "ESLint-fix summary: fixes not applied (patch-only mode); lint not run." >&2
    exit 0
  fi
  echo "Unstaged changes detected outside target paths; continuing because --allow-dirty-outside-targets was set." >&2
fi

if [ "${skip_preview_patch:-false}" != true ]; then
  echo "Preview: ${change_count} file(s) would change." >&2
  echo "Patch: ${PATCH_FILE}" >&2
fi

if [ "$auto_yes" = false ]; then
  if [ -t 0 ]; then
    printf "Apply these changes? [y/N] "
    read -r reply
    case "$reply" in
      y|Y) ;;
      *) echo "Not applying changes." >&2; echo "ESLint-fix summary: fixes not applied (prompt declined); lint not run." >&2; exit 0 ;;
    esac
  else
    echo "No TTY available. Not applying changes." >&2
    echo "ESLint-fix summary: fixes not applied (no TTY); lint not run." >&2
    exit 0
  fi
fi

cd "$PROJECT_ROOT"
if [ "$ESLINT_CONFIG_MODE" = "nearest" ]; then
  fix_exit=0
  for config_path in "${!ESLINT_GROUPS[@]}"; do
    mapfile -t group_files <<< "${ESLINT_GROUPS[$config_path]}"
    filtered_files=()
    for item in "${group_files[@]}"; do
      [ -n "$item" ] || continue
      filtered_files+=("$item")
    done
    if [ "${#filtered_files[@]}" -eq 0 ]; then
      continue
    fi
    config_path_abs="$config_path"
    if [[ "$config_path_abs" != /* ]]; then
      config_path_abs="${PROJECT_ROOT}/${config_path_abs}"
    fi
    config_path_run="$config_path"
    if [[ "$config_path_run" == /* ]]; then
      config_path_run="$config_path_abs"
    fi
    config_dir="$(dirname "$config_path_abs")"
    plugins_dir="$(resolve_plugins_dir "$config_dir")"
    echo "Applying ESLint fixes: config ${config_path_abs} (${#filtered_files[@]} file(s))." >&2
    group_cmd=(env "NODE_PATH=$NODE_PATH" node "$TOOLCHAIN_BIN" --quiet --config="$config_path_run")
    if [ -n "$plugins_dir" ]; then
      group_cmd+=(--resolve-plugins-relative-to "$plugins_dir")
    fi
    group_cmd+=(--ext .js,.yml --ignore-pattern "**/node_modules/**" --fix)
    "${group_cmd[@]}" "${filtered_files[@]}"
    status=$?
    if [ $status -ne 0 ]; then
      fix_exit=$status
    fi
  done
else
  "${CMD_BASE[@]}" --fix "${FILES[@]}"
  fix_exit=$?
fi

cd "$PROJECT_ROOT"
if [ "$fix_exit" -eq 0 ]; then
  fix_summary="fixes applied"
  echo "ESLint fixes applied." >&2
elif [ "$fix_exit" -eq 1 ]; then
  fix_summary="fixes applied (remaining issues)"
  echo "ESLint fixes applied; remaining issues still exist." >&2
else
  fix_summary="fix step failed (exit ${fix_exit})"
  echo "ESLint fix run exited with status ${fix_exit}." >&2
fi
echo "Running ESLint to report any remaining issues..." >&2
./.ddev/commands/web/eslint "${clean_args[@]}"
check_exit=$?

if [ "$check_exit" -ne 0 ]; then
  lint_summary="remaining issues (exit ${check_exit})"
else
  lint_summary="no remaining issues"
fi
echo "ESLint-fix summary: ${fix_summary}; lint ${lint_summary}." >&2

if [ "$fix_exit" -ne 0 ]; then
  exit "$fix_exit"
fi
exit "$check_exit"
if ! command -v node >/dev/null 2>&1; then
  echo "Node.js is not available in the DDEV web container." >&2
  echo "Install Node toolchain (e.g. in ${DOCROOT}/core via yarn) to run ESLint." >&2
  exit 127
fi
