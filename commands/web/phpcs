#!/usr/bin/env bash
#ddev-generated
set -u

PHPCS_BIN="vendor/bin/phpcs"

if [ ! -x "$PHPCS_BIN" ]; then
  echo "phpcs not found at $PHPCS_BIN. Run 'ddev composer install' to install vendor/bin/phpcs." >&2
  exit 127
fi

has_config=false
for config_file in .phpcs.xml phpcs.xml phpcs.xml.dist .phpcs.xml.dist; do
  if [ -f "$config_file" ]; then
    has_config=true
    break
  fi
done

if [ "$has_config" = true ]; then
  "$PHPCS_BIN" "$@"
  exit $?
fi

echo "PHPCS config file is missing. Create .phpcs.xml in the project root (for example by reinstalling the add-on)." >&2
exit 2
