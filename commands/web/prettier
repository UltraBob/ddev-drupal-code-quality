#!/bin/bash
#ddev-generated
set -u

print_help() {
  cat <<'USAGE'
Usage: ddev prettier [args]

Runs Prettier in check mode inside the DDEV web container with Drupal CI config.
USAGE
}

has_help=false
has_version=false
has_positional=false
has_config=false
seen_double_dash=false
explicit_paths=false

for arg in "$@"; do
  if [ "$seen_double_dash" = true ]; then
    has_positional=true
    explicit_paths=true
    break
  fi
  case "$arg" in
    --)
      seen_double_dash=true
      ;;
    -h|--help)
      has_help=true
      ;;
    -V|--version)
      has_version=true
      ;;
    -c|--config|--config=*)
      has_config=true
      ;;
    --)
      ;;
    -* )
      ;;
    *)
      has_positional=true
      explicit_paths=true
      ;;
  esac
  if [ "$has_help" = true ] || [ "$has_version" = true ]; then
    break
  fi
done

if [ "$has_help" = true ]; then
  print_help
fi

if ! command -v node >/dev/null 2>&1; then
  echo "Node.js is not available in the DDEV web container." >&2
  echo "Install the Drupal core JS toolchain (web/core) to run Prettier." >&2
  exit 127
fi

PROJECT_ROOT="/var/www/html"
CORE_PRETTIER="${PROJECT_ROOT}/web/core/node_modules/.bin/prettier"
ROOT_PRETTIER="${PROJECT_ROOT}/node_modules/.bin/prettier"
PRETTIER_BIN=""
NODE_PATH=""

if [ -x "$ROOT_PRETTIER" ]; then
  PRETTIER_BIN="$ROOT_PRETTIER"
  NODE_PATH="${PROJECT_ROOT}/node_modules"
elif [ -x "$CORE_PRETTIER" ]; then
  PRETTIER_BIN="$CORE_PRETTIER"
  NODE_PATH="${PROJECT_ROOT}/web/core/node_modules"
else
  echo "Prettier is not installed in web/core/node_modules or node_modules." >&2
  echo "Enable corepack and run 'yarn install' in web/core, or install prettier in the project root." >&2
  exit 127
fi

if [ "$has_help" = true ]; then
  "$PRETTIER_BIN" --help
  exit $?
fi

if [ "$has_version" = true ]; then
  "$PRETTIER_BIN" --version
  exit $?
fi

# Run from the Drupal docroot so config resolution matches CI expectations.
cd web

CMD=(env "NODE_PATH=$NODE_PATH" "$PRETTIER_BIN" --check)
if [ "$has_config" = false ]; then
  # Prefer project configs; warn when falling back to core.
  if [ -f "${PROJECT_ROOT}/.prettierrc.json" ]; then
    CMD+=(--config="${PROJECT_ROOT}/.prettierrc.json")
  else
    CMD+=(--config="${PROJECT_ROOT}/web/core/.prettierrc.json")
    echo "Warning: using core Prettier config (web/core/.prettierrc.json); project config not found." >&2
  fi
  if [ -f "${PROJECT_ROOT}/.prettierignore" ]; then
    CMD+=(--ignore-path="${PROJECT_ROOT}/.prettierignore")
  elif [ -f "${PROJECT_ROOT}/web/core/.prettierignore" ]; then
    CMD+=(--ignore-path="${PROJECT_ROOT}/web/core/.prettierignore")
    echo "Warning: using core Prettier ignore (web/core/.prettierignore); project ignore not found." >&2
  fi
fi

normalize_prettier_path() {
  local path="$1"
  if [[ "$path" == /var/www/html/* ]]; then
    path="${path#/var/www/html/}"
  fi
  if [ "$path" = "web" ]; then
    echo "."
    return
  fi
  if [[ "$path" == web/* ]]; then
    path="${path#web/}"
  fi
  echo "$path"
}

FINAL_ARGS=()
if [ "$explicit_paths" = true ]; then
  args=("$@")
  arg_count=${#args[@]}
  index=0
  seen_double_dash=false
  while [ "$index" -lt "$arg_count" ]; do
    arg="${args[$index]}"
    if [ "$seen_double_dash" = true ]; then
      FINAL_ARGS+=("$(normalize_prettier_path "$arg")")
      index=$((index + 1))
      continue
    fi
    case "$arg" in
      --)
        seen_double_dash=true
        FINAL_ARGS+=("$arg")
        ;;
      -c|--config|--ignore-path)
        FINAL_ARGS+=("$arg")
        next_arg="${args[$((index + 1))]:-}"
        if [ -n "$next_arg" ]; then
          FINAL_ARGS+=("$next_arg")
          index=$((index + 1))
        fi
        ;;
      --config=*|--ignore-path=*)
        FINAL_ARGS+=("$arg")
        ;;
      -*)
        FINAL_ARGS+=("$arg")
        ;;
      *)
        FINAL_ARGS+=("$(normalize_prettier_path "$arg")")
        ;;
    esac
    index=$((index + 1))
  done
fi

if [ "$explicit_paths" = false ]; then
  # Default to custom code only when no explicit paths are passed.
  DEFAULT_FILES=()
  for candidate in modules/custom themes/custom profiles/custom; do
    if [ -d "$candidate" ]; then
      while IFS= read -r file_path; do
        DEFAULT_FILES+=("$file_path")
      done < <(find "$candidate" -type f \( -name '*.js' -o -name '*.yml' -o -name '*.yaml' -o -name '*.css' -o -name '*.scss' -o -name '*.sass' \))
    fi
  done
  if [ "${#DEFAULT_FILES[@]}" -eq 0 ]; then
    echo "No custom files found under modules/custom, themes/custom, or profiles/custom. Nothing to check." >&2
    exit 0
  fi
  "${CMD[@]}" "$@" "${DEFAULT_FILES[@]}"
  exit $?
fi

"${CMD[@]}" "${FINAL_ARGS[@]}"
exit $?
