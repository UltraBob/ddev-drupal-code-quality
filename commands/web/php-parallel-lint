#!/bin/bash
#ddev-generated
set -u

print_help() {
  cat <<'USAGE'
Usage: ddev php-parallel-lint [args]

Runs PHP parallel lint inside the DDEV web container (CI parity).
USAGE
}

for arg in "$@"; do
  case "$arg" in
    -h|--help)
      print_help
      if [ -x "vendor/bin/parallel-lint" ]; then
        vendor/bin/parallel-lint --help || true
      elif [ -x "vendor/bin/php-parallel-lint" ]; then
        vendor/bin/php-parallel-lint --help || true
      fi
      exit 0
      ;;
  esac
done

LINT_BIN=""
if [ -x "vendor/bin/parallel-lint" ]; then
  # Prefer the newer binary name when available.
  LINT_BIN="vendor/bin/parallel-lint"
elif [ -x "vendor/bin/php-parallel-lint" ]; then
  LINT_BIN="vendor/bin/php-parallel-lint"
fi

if [ -z "$LINT_BIN" ]; then
  echo "php-parallel-lint is not installed in vendor/bin." >&2
  echo "Install php-parallel-lint/php-parallel-lint via Composer to enable this check." >&2
  exit 127
fi

DEFAULT_FILES=()
for candidate in web/modules/custom web/themes/custom web/profiles/custom; do
  if [ -d "$candidate" ]; then
    while IFS= read -r file_path; do
      DEFAULT_FILES+=("$file_path")
    done < <(find "$candidate" -type f \( -name '*.php' -o -name '*.inc' -o -name '*.module' -o -name '*.install' -o -name '*.theme' -o -name '*.profile' \))
  fi
 done

if [ "${#DEFAULT_FILES[@]}" -eq 0 ] && [ "$#" -eq 0 ]; then
  # Skip quietly if no custom PHP files are present.
  echo "No custom PHP files found under web/modules/custom, web/themes/custom, or web/profiles/custom. Nothing to check." >&2
  exit 0
fi

if [ "$#" -eq 0 ]; then
  "$LINT_BIN" "${DEFAULT_FILES[@]}"
  exit $?
fi

"$LINT_BIN" "$@"
exit $?
