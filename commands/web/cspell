#!/bin/bash
#ddev-generated
set -u

print_help() {
  cat <<'USAGE'
Usage: ddev cspell [args]

Runs CSpell inside the DDEV web container with Drupal CI parity config.
USAGE
}

has_help=false
has_version=false
has_positional=false
has_config=false
seen_double_dash=false
explicit_paths=false

for arg in "$@"; do
  if [ "$seen_double_dash" = true ]; then
    has_positional=true
    explicit_paths=true
    break
  fi
  case "$arg" in
    --)
      seen_double_dash=true
      ;;
    -h|--help)
      has_help=true
      ;;
    -V|--version)
      has_version=true
      ;;
    -c|--config|--config=*)
      has_config=true
      ;;
    --)
      ;;
    -* )
      ;;
    *)
      has_positional=true
      explicit_paths=true
      ;;
  esac
  if [ "$has_help" = true ] || [ "$has_version" = true ]; then
    break
  fi
done

if [ "$has_help" = true ]; then
  print_help
fi

if ! command -v node >/dev/null 2>&1; then
  echo "Node.js is not available in the DDEV web container." >&2
  echo "Install the Drupal core JS toolchain (web/core) to run CSpell." >&2
  exit 127
fi

PROJECT_ROOT="/var/www/html"
CORE_CSPELL="${PROJECT_ROOT}/web/core/node_modules/.bin/cspell"
ROOT_CSPELL="${PROJECT_ROOT}/node_modules/.bin/cspell"
CSPELL_BIN=""

if [ -x "$ROOT_CSPELL" ]; then
  CSPELL_BIN="$ROOT_CSPELL"
elif [ -x "$CORE_CSPELL" ]; then
  CSPELL_BIN="$CORE_CSPELL"
else
  echo "CSpell is not installed in web/core/node_modules or node_modules." >&2
  echo "Enable corepack and run 'yarn install' in web/core, or install cspell in the project root." >&2
  exit 127
fi

if [ "$has_help" = true ]; then
  "$CSPELL_BIN" --help
  exit $?
fi

if [ "$has_version" = true ]; then
  "$CSPELL_BIN" --version
  exit $?
fi

CMD=("$CSPELL_BIN")
if [ "$has_config" = false ]; then
  # Prefer project config; warn when falling back to core.
  if [ -f "${PROJECT_ROOT}/.cspell.json" ]; then
    CMD+=(-c "${PROJECT_ROOT}/.cspell.json")
  else
    CMD+=(-c "${PROJECT_ROOT}/web/core/.cspell.json")
    echo "Warning: using core CSpell config (web/core/.cspell.json); project config not found." >&2
  fi
fi

normalize_path() {
  local path="$1"
  if [[ "$path" == /var/www/html/* ]]; then
    path="${path#/var/www/html/}"
  fi
  if [[ "$path" == modules/* || "$path" == themes/* || "$path" == profiles/* ]]; then
    echo "web/$path"
    return
  fi
  echo "$path"
}

trim_line() {
  local line="$1"
  line="${line%%#*}"
  line="${line#"${line%%[![:space:]]*}"}"
  line="${line%"${line##*[![:space:]]}"}"
  printf '%s' "$line"
}

collect_root_files() {
  while IFS= read -r file_path; do
    DEFAULT_FILES+=("$file_path")
  done < <(find "$PROJECT_ROOT" -maxdepth 1 -type f -print)
}

FLAG_ARGS=()
POSITIONAL_ARGS=()
args=("$@")
arg_count=${#args[@]}
index=0
seen_double_dash=false
while [ "$index" -lt "$arg_count" ]; do
  arg="${args[$index]}"
  if [ "$seen_double_dash" = true ]; then
    POSITIONAL_ARGS+=("$(normalize_path "$arg")")
    index=$((index + 1))
    continue
  fi
  case "$arg" in
    --)
      seen_double_dash=true
      FLAG_ARGS+=("$arg")
      ;;
    -c|--config)
      FLAG_ARGS+=("$arg" "${args[$((index + 1))]:-}")
      index=$((index + 1))
      ;;
    --config=*)
      FLAG_ARGS+=("$arg")
      ;;
    -*)
      FLAG_ARGS+=("$arg")
      ;;
    *)
      POSITIONAL_ARGS+=("$(normalize_path "$arg")")
      ;;
  esac
  index=$((index + 1))
done

if [ "$explicit_paths" = false ]; then
  TARGETS_FILE="${PROJECT_ROOT}/tooling/cspell-targets.txt"
  DEFAULT_FILES=()
  DEFAULT_PATTERNS=()
  root_files=false
  has_targets=false

  if [ -f "$TARGETS_FILE" ]; then
    while IFS= read -r line || [ -n "$line" ]; do
      line="$(trim_line "$line")"
      [ -n "$line" ] || continue
      if [ "$line" = "./*" ] || [ "$line" = "ROOT_FILES" ]; then
        root_files=true
        has_targets=true
        continue
      fi
      line="$(normalize_path "$line")"
      if [[ "$line" == *"*"* || "$line" == *"?"* || "$line" == *"["* ]]; then
        DEFAULT_PATTERNS+=("$line")
        has_targets=true
        continue
      fi
      if [ -d "$line" ]; then
        while IFS= read -r file_path; do
          DEFAULT_FILES+=("$file_path")
        done < <(find "$line" -path '*/node_modules/*' -prune -o -type f -print)
        has_targets=true
      elif [ -f "$line" ]; then
        DEFAULT_FILES+=("$line")
        has_targets=true
      fi
    done < "$TARGETS_FILE"
  fi

  if [ "$root_files" = true ]; then
    collect_root_files
  fi

  if [ "$has_targets" = false ]; then
    for candidate in web/modules/custom web/themes/custom web/profiles/custom; do
      if [ -d "$candidate" ]; then
        while IFS= read -r file_path; do
          DEFAULT_FILES+=("$file_path")
        done < <(find "$candidate" -path '*/node_modules/*' -prune -o -type f -print)
      fi
    done
    collect_root_files
  fi

  if [ "${#DEFAULT_FILES[@]}" -eq 0 ] && [ "${#DEFAULT_PATTERNS[@]}" -eq 0 ]; then
    echo "No target files found for CSpell. Nothing to check." >&2
    exit 0
  fi
  "${CMD[@]}" "${FLAG_ARGS[@]}" "${DEFAULT_PATTERNS[@]}" "${DEFAULT_FILES[@]}"
  exit $?
fi

"${CMD[@]}" "${FLAG_ARGS[@]}" "${POSITIONAL_ARGS[@]}"
exit $?
