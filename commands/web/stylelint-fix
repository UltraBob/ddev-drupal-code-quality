#!/bin/bash
#ddev-generated
set -u

print_help() {
  cat <<'USAGE'
Usage: ddev stylelint-fix [args]

Previews Stylelint fixes and applies them only after confirmation.

By default, fixes are not auto-applied when the working tree has changes
outside the target paths. This prevents mixing unrelated work with automated
style updates and makes it easier to review and revert fixes. If you are
intentionally running fixes while the worktree is dirty outside the target
paths, pass --allow-dirty-outside-targets (or --allow-dirty) to bypass this
protection.
USAGE
}

PROJECT_ROOT="/var/www/html"
CORE_STYLELINT="${PROJECT_ROOT}/web/core/node_modules/stylelint/bin/stylelint.mjs"
ROOT_STYLELINT="${PROJECT_ROOT}/node_modules/stylelint/bin/stylelint.mjs"
TOOLCHAIN_BIN=""
NODE_PATH=""

has_help=false
has_version=false
has_positional=false
has_config=false
seen_double_dash=false
explicit_paths=false
auto_yes=false
allow_dirty_outside_targets=false
clean_args=()

for arg in "$@"; do
  if [ "$arg" = "--yes" ]; then
    auto_yes=true
    continue
  fi
  if [ "$arg" = "--allow-dirty-outside-targets" ] || [ "$arg" = "--allow-dirty" ]; then
    # Allow applying fixes even when unrelated files are dirty.
    allow_dirty_outside_targets=true
    continue
  fi
  clean_args+=("$arg")
done

for arg in "${clean_args[@]}"; do
  if [ "$seen_double_dash" = true ]; then
    has_positional=true
    explicit_paths=true
    break
  fi
  case "$arg" in
    --)
      seen_double_dash=true
      ;;
    -h|--help)
      has_help=true
      ;;
    -V|--version)
      has_version=true
      ;;
    -c|--config|--config=*)
      has_config=true
      ;;
    --)
      ;;
    -* )
      ;;
    *)
      has_positional=true
      explicit_paths=true
      ;;
  esac
  if [ "$has_help" = true ] || [ "$has_version" = true ]; then
    break
  fi
done

if [ "$has_help" = true ]; then
  print_help
fi

if ! command -v node >/dev/null 2>&1; then
  echo "Node.js is not available in the DDEV web container." >&2
  echo "Install the Drupal core JS toolchain (web/core) to run Stylelint." >&2
  exit 127
fi

if [ -f "$ROOT_STYLELINT" ]; then
  TOOLCHAIN_BIN="$ROOT_STYLELINT"
  NODE_PATH="${PROJECT_ROOT}/node_modules"
elif [ -f "$CORE_STYLELINT" ]; then
  TOOLCHAIN_BIN="$CORE_STYLELINT"
  NODE_PATH="${PROJECT_ROOT}/web/core/node_modules"
else
  echo "Stylelint is not installed in web/core/node_modules or node_modules." >&2
  echo "Enable corepack and run 'yarn install' in web/core, or install stylelint in the project root." >&2
  exit 127
fi

PROJECT_ROOT="/var/www/html"

if [ "$has_help" = true ]; then
  node "$TOOLCHAIN_BIN" --help
  exit $?
fi

if [ "$has_version" = true ]; then
  node "$TOOLCHAIN_BIN" --version
  exit $?
fi

REPORT_DIR="tooling/reports"
mkdir -p "$REPORT_DIR"
PATCH_FILE="${REPORT_DIR}/_stylelint.patch"

normalize_path() {
  local path="$1"
  # Normalize paths into repo-relative paths for matching target prefixes.
  if [[ "$path" == /var/www/html/* ]]; then
    path="${path#/var/www/html/}"
  fi
  if [[ "$path" == web/* ]]; then
    echo "$path"
    return
  fi
  if [[ "$path" == modules/* || "$path" == themes/* || "$path" == profiles/* ]]; then
    echo "web/$path"
    return
  fi
  echo "$path"
}

TARGET_PREFIXES=()
RAW_PATHS=()
seen_double_dash=false
args=("${clean_args[@]}")
arg_count=${#args[@]}
index=0
while [ "$index" -lt "$arg_count" ]; do
  arg="${args[$index]}"
  if [ "$seen_double_dash" = true ]; then
    RAW_PATHS+=("$arg")
    index=$((index + 1))
    continue
  fi
  case "$arg" in
    --)
      seen_double_dash=true
      ;;
    -c|--config)
      index=$((index + 1))
      ;;
    --config=*)
      ;;
    -* )
      ;;
    *)
      RAW_PATHS+=("$arg")
      ;;
  esac
  index=$((index + 1))
done

if [ "${#RAW_PATHS[@]}" -gt 0 ]; then
  for raw in "${RAW_PATHS[@]}"; do
    TARGET_PREFIXES+=("$(normalize_path "$raw")")
  done
else
  # Default to custom code when no explicit paths are provided.
  for candidate in web/modules/custom web/themes/custom web/profiles/custom; do
    if [ -d "$candidate" ]; then
      TARGET_PREFIXES+=("$candidate")
    fi
  done
fi

unrelated_changes=false
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  mapfile -t unstaged_files < <(git diff --name-only)
  mapfile -t untracked_files < <(git ls-files --others --exclude-standard)
  for file in "${unstaged_files[@]}" "${untracked_files[@]}"; do
    [ -z "$file" ] && continue
    matched=false
    for prefix in "${TARGET_PREFIXES[@]}"; do
      [ -z "$prefix" ] && continue
      if [[ "$file" == "$prefix"* ]]; then
        matched=true
        break
      fi
    done
    if [ "$matched" = false ]; then
      # Guard against applying fixes when unrelated changes are present.
      unrelated_changes=true
      break
    fi
  done
fi

CMD_BASE=(env "NODE_PATH=$NODE_PATH" node "$TOOLCHAIN_BIN")
if [ "$has_config" = false ]; then
  if [ -f "${PROJECT_ROOT}/.stylelintrc.json" ]; then
    CMD_BASE+=(--config="${PROJECT_ROOT}/.stylelintrc.json")
  else
    CMD_BASE+=(--config="${PROJECT_ROOT}/web/core/.stylelintrc.json")
    echo "Warning: using core Stylelint config (web/core/.stylelintrc.json); project config not found." >&2
  fi
fi

find_stylelint_config() {
  local path="$1"
  local dir="$path"
  if [ -f "$dir" ]; then
    dir="$(dirname "$dir")"
  fi
  while [ "$dir" != "." ] && [ "$dir" != "/" ]; do
    for candidate in .stylelintrc .stylelintrc.json .stylelintrc.yaml .stylelintrc.yml .stylelintrc.js; do
      if [ -f "$dir/$candidate" ]; then
        echo "$dir/$candidate"
        return 0
      fi
    done
    dir="$(dirname "$dir")"
  done
  return 1
}

CUSTOM_SYNTAX_PATH=""
find_scss_parser() {
  local path
  IFS=':' read -r -a paths <<< "$NODE_PATH"
  for path in "${paths[@]}"; do
    [ -z "$path" ] && continue
    if [[ "$path" != /* ]]; then
      path="${PROJECT_ROOT}/web/${path}"
    fi
    if [ -f "$path/postcss-scss/lib/scss-syntax.js" ]; then
      CUSTOM_SYNTAX_PATH="$path/postcss-scss/lib/scss-syntax.js"
      return 0
    fi
  done
  return 1
}

DEFAULT_CONFIG_PATH=""
if [ "$has_config" = false ]; then
  if [ -f "${PROJECT_ROOT}/.stylelintrc.json" ]; then
    CONFIG_PATH="${PROJECT_ROOT}/.stylelintrc.json"
  else
    CONFIG_PATH="${PROJECT_ROOT}/web/core/.stylelintrc.json"
  fi
  DEFAULT_CONFIG_PATH="$CONFIG_PATH"
else
  CONFIG_PATH=""
fi

config_supports_scss() {
  local path="$1"
  local full_path="$path"
  if [ -z "$full_path" ]; then
    return 1
  fi
  if [[ "$full_path" != /* ]]; then
    full_path="${PROJECT_ROOT}/web/${full_path}"
  fi
  if [ ! -f "$full_path" ]; then
    return 1
  fi
  if grep -E -q 'stylelint-scss|standard-scss|recommended-scss' "$full_path"; then
    return 0
  fi
  return 1
}

uses_scss=false
has_scss_parser=false
scss_allowed=false

FINAL_ARGS=()
if [ "$explicit_paths" = true ]; then
  arg_count=${#args[@]}
  index=0
  seen_double_dash=false
  while [ "$index" -lt "$arg_count" ]; do
    arg="${args[$index]}"
    if [ "$seen_double_dash" = true ]; then
      if [[ "$arg" == web/* ]]; then
        arg="${arg#web/}"
      elif [ "$arg" = "web" ]; then
        arg="."
      fi
      FINAL_ARGS+=("$arg")
      index=$((index + 1))
      continue
    fi
    case "$arg" in
      --)
        seen_double_dash=true
        FINAL_ARGS+=("$arg")
        ;;
      -c|--config)
        next_arg="${args[$((index + 1))]:-}"
        if [[ "$next_arg" == web/* ]]; then
          next_arg="${next_arg#web/}"
        elif [ "$next_arg" = "web" ]; then
          next_arg="."
        fi
        FINAL_ARGS+=("$arg" "$next_arg")
        index=$((index + 1))
        ;;
      --config=*)
        config_value="${arg#*=}"
        if [[ "$config_value" == web/* ]]; then
          config_value="${config_value#web/}"
        elif [ "$config_value" = "web" ]; then
          config_value="."
        fi
        FINAL_ARGS+=("--config=$config_value")
        ;;
      -* )
        FINAL_ARGS+=("$arg")
        ;;
      *)
        if [[ "$arg" == web/* ]]; then
          arg="${arg#web/}"
        elif [ "$arg" = "web" ]; then
          arg="."
        fi
        FINAL_ARGS+=("$arg")
        ;;
    esac
    index=$((index + 1))
  done

  if [ "$has_config" = false ] && [ "$CONFIG_PATH" = "$DEFAULT_CONFIG_PATH" ]; then
    for path in "${FINAL_ARGS[@]}"; do
      if config_candidate="$(find_stylelint_config "$path")"; then
        CONFIG_PATH="$config_candidate"
        config_dir="$(dirname "$CONFIG_PATH")"
        if [[ "$config_dir" != /* ]]; then
          config_dir="${PROJECT_ROOT}/web/${config_dir}"
        fi
        if [ -d "$config_dir/node_modules" ]; then
          NODE_PATH="${NODE_PATH}:${config_dir}/node_modules"
        fi
        CMD_BASE=(env "NODE_PATH=$NODE_PATH" node "$TOOLCHAIN_BIN" --config="$CONFIG_PATH" --config-basedir="$config_dir")
        break
      fi
    done
  fi

  for path in "${FINAL_ARGS[@]}"; do
    if [[ "$path" == *.scss || "$path" == *.sass ]]; then
      uses_scss=true
      break
    fi
    if [ -d "$path" ]; then
      if find "$path" -type f \( -name '*.scss' -o -name '*.sass' \) -print -quit 2>/dev/null | grep -q .; then
        uses_scss=true
        break
      fi
    fi
  done
  if [ "$uses_scss" = true ] && config_supports_scss "$CONFIG_PATH"; then
    scss_allowed=true
  fi
fi

DEFAULT_FILES=()
if [ "$explicit_paths" = false ]; then
  # Use docroot-relative paths for default discovery.
  cd web
  for candidate in modules/custom themes/custom profiles/custom; do
    if [ -d "$candidate" ]; then
      while IFS= read -r file_path; do
        DEFAULT_FILES+=("$file_path")
      done < <(find "$candidate" -type f \( -name '*.css' -o -name '*.scss' -o -name '*.sass' \))
    fi
  done
  if [ "${#DEFAULT_FILES[@]}" -eq 0 ]; then
    echo "No custom style files found under modules/custom, themes/custom, or profiles/custom. Nothing to fix." >&2
    exit 2
  fi
  if [ "$has_config" = false ] && [ "$CONFIG_PATH" = "$DEFAULT_CONFIG_PATH" ]; then
    for file_path in "${DEFAULT_FILES[@]}"; do
      if config_candidate="$(find_stylelint_config "$file_path")"; then
        CONFIG_PATH="$config_candidate"
        config_dir="$(dirname "$CONFIG_PATH")"
        if [[ "$config_dir" != /* ]]; then
          config_dir="${PROJECT_ROOT}/web/${config_dir}"
        fi
        if [ -d "$config_dir/node_modules" ]; then
          NODE_PATH="${NODE_PATH}:${config_dir}/node_modules"
        fi
        CMD_BASE=(env "NODE_PATH=$NODE_PATH" node "$TOOLCHAIN_BIN" --config="$CONFIG_PATH" --config-basedir="$config_dir")
        break
      fi
    done
  fi
  cd "$PROJECT_ROOT"
  for file_path in "${DEFAULT_FILES[@]}"; do
    if [[ "$file_path" == *.scss || "$file_path" == *.sass ]]; then
      uses_scss=true
      break
    fi
  done
  if [ "$uses_scss" = true ] && config_supports_scss "$CONFIG_PATH"; then
    scss_allowed=true
  fi
fi

FILTERED_FILES=()
FILTERED_ARGS=()
if [ "$explicit_paths" = false ]; then
  FILTERED_FILES=("${DEFAULT_FILES[@]}")
else
  FILTERED_ARGS=("${FINAL_ARGS[@]}")
fi

if [ "$uses_scss" = true ] && [ "$scss_allowed" = true ] && find_scss_parser; then
  CMD_BASE+=(--custom-syntax="$CUSTOM_SYNTAX_PATH")
  has_scss_parser=true
fi

if [ "$uses_scss" = true ] && [ "$scss_allowed" = false ]; then
  if [ "$explicit_paths" = false ]; then
    FILTERED_FILES=()
    for file_path in "${DEFAULT_FILES[@]}"; do
      if [[ "$file_path" == *.scss || "$file_path" == *.sass ]]; then
        continue
      fi
      FILTERED_FILES+=("$file_path")
    done
    if [ "${#FILTERED_FILES[@]}" -eq 0 ]; then
      echo "No CSS files left to fix after excluding SCSS/Sass (config does not support SCSS)." >&2
      exit 2
    fi
  else
    FILTERED_ARGS=()
    for arg in "${FINAL_ARGS[@]}"; do
      if [[ "$arg" == *.scss || "$arg" == *.sass ]]; then
        continue
      fi
      FILTERED_ARGS+=("$arg")
    done
    if [ "${#FILTERED_ARGS[@]}" -eq 0 ]; then
      echo "No CSS files left to fix after excluding SCSS/Sass (config does not support SCSS)." >&2
      exit 2
    fi
  fi
fi

if [ "$uses_scss" = true ] && [ "$has_scss_parser" = false ] && [ "$scss_allowed" = true ]; then
  if [ "$explicit_paths" = false ]; then
    FILTERED_FILES=()
    for file_path in "${DEFAULT_FILES[@]}"; do
      if [[ "$file_path" == *.scss || "$file_path" == *.sass ]]; then
        continue
      fi
      FILTERED_FILES+=("$file_path")
    done
    if [ "${#FILTERED_FILES[@]}" -eq 0 ]; then
      echo "No CSS files left to fix after excluding SCSS/Sass (SCSS parser not available)." >&2
      exit 2
    fi
  else
    FILTERED_ARGS=()
    for arg in "${FINAL_ARGS[@]}"; do
      if [[ "$arg" == *.scss || "$arg" == *.sass ]]; then
        continue
      fi
      FILTERED_ARGS+=("$arg")
    done
    if [ "${#FILTERED_ARGS[@]}" -eq 0 ]; then
      echo "No CSS files left to fix after excluding SCSS/Sass (SCSS parser not available)." >&2
      exit 2
    fi
  fi
fi

tmp_root="$(mktemp -d)"
trap 'rm -rf "$tmp_root"' EXIT

cd "$PROJECT_ROOT"
tar -cf - \
  --exclude=./.git \
  --exclude=./.trunk \
  --exclude=./node_modules \
  --exclude=./vendor \
  --exclude=./tooling/reports \
  --exclude=./web/core/node_modules \
  --exclude='*/.git' \
  --exclude='*/.git/*' \
  . | (cd "$tmp_root" && tar -xf -)

if [ "$explicit_paths" = false ]; then
  (cd "$tmp_root/web" && "${CMD_BASE[@]}" --fix "${FILTERED_FILES[@]}")
else
  (cd "$tmp_root/web" && "${CMD_BASE[@]}" --fix "${FILTERED_ARGS[@]}")
fi

: > "${PATCH_FILE}.raw"
for prefix in "${TARGET_PREFIXES[@]}"; do
  [ -z "$prefix" ] && continue
  if [ ! -e "$PROJECT_ROOT/$prefix" ] && [ ! -e "$tmp_root/$prefix" ]; then
    continue
  fi
  diff -ruN \
    --exclude=.git \
    --exclude='.git/*' \
    "$PROJECT_ROOT/$prefix" "$tmp_root/$prefix" >> "${PATCH_FILE}.raw" || true
done

sed -E "s/diff -ruN( '--exclude=[^']+')+/diff -ruN/" "${PATCH_FILE}.raw" > "$PATCH_FILE"
rm -f "${PATCH_FILE}.raw"

change_count=$(grep -c '^diff -ruN ' "$PATCH_FILE" || true)
if [ "$change_count" -eq 0 ]; then
  change_count=$(grep -c '^--- ' "$PATCH_FILE" || true)
fi
skip_fix_apply=false
fix_exit=0
fix_summary="fixes not applied"
if [ "$change_count" -eq 0 ]; then
  echo "No Stylelint fixes to apply. Running Stylelint to report remaining issues." >&2
  skip_fix_apply=true
  fix_summary="no fixes to apply"
fi

if [ "$skip_fix_apply" = false ]; then
  echo "Preview: ${change_count} file(s) would change." >&2
  echo "Patch: ${PATCH_FILE}" >&2

  if [ "$unrelated_changes" = true ]; then
    if [ "$allow_dirty_outside_targets" = false ]; then
      echo "Unstaged changes detected outside target paths. Patch-only mode: not applying automatically." >&2
      echo "Re-run with --allow-dirty-outside-targets (or --allow-dirty) to apply fixes anyway." >&2
      echo "To apply the patch manually, run: git apply ${PATCH_FILE}" >&2
      echo "Stylelint-fix summary: fixes not applied (patch-only mode). Lint not run." >&2
      exit 0
    fi
    echo "Unstaged changes detected outside target paths; continuing because --allow-dirty-outside-targets was set." >&2
  fi

  if [ "$auto_yes" = false ]; then
    if [ -t 0 ]; then
      printf "Apply these changes? [y/N] "
      read -r reply
      case "$reply" in
        y|Y) ;;
        *) echo "Not applying changes." >&2; echo "Stylelint-fix summary: fixes not applied (prompt declined). Lint not run." >&2; exit 0 ;;
      esac
    else
      echo "No TTY available. Not applying changes." >&2
      echo "Stylelint-fix summary: fixes not applied (no TTY). Lint not run." >&2
      exit 0
    fi
  fi

  cd "$PROJECT_ROOT/web"
  if [ "$explicit_paths" = false ]; then
    "${CMD_BASE[@]}" --fix "${FILTERED_FILES[@]}"
  else
    "${CMD_BASE[@]}" --fix "${FILTERED_ARGS[@]}"
  fi
  fix_exit=$?

  if [ "$fix_exit" -eq 0 ]; then
    echo "Stylelint fixes applied." >&2
    fix_summary="fixes applied"
  else
    echo "Stylelint fix run exited with status ${fix_exit}." >&2
    fix_summary="fix step failed (exit ${fix_exit})"
  fi
fi

cd "$PROJECT_ROOT"
echo "Running Stylelint to report any remaining issues..." >&2
./.ddev/commands/web/stylelint "${clean_args[@]}"
check_exit=$?

if [ "$check_exit" -ne 0 ]; then
  lint_summary="remaining issues (exit ${check_exit})"
else
  lint_summary="no remaining issues"
fi
echo "Stylelint-fix summary: ${fix_summary}; lint ${lint_summary}." >&2

if [ "$fix_exit" -ne 0 ]; then
  exit "$fix_exit"
fi
exit "$check_exit"
